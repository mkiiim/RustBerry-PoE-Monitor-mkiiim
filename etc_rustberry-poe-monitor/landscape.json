{
  "orientation": "landscape",
  "font": "PCSENIOR8_STYLE",
  "lines": [
    { "leading": 7, "align": "center",
      "row": [{ "text": "{interface}: ", "font": "FONT_5X8" }, { "text": "{ip}", "font": "FONT_6X12" }] },
    { "leading": 12, "row": [
      { "width": 64, "row": [{ "text": "{cpu_usage}", "width": 38, "align": "right" }, { "space": 2 },
                             { "text": "%", "font": "FONT_6X12", "dy": 1 }, { "text": "CPU", "font": "FONT_5X8", "dy": 1 }] },
      { "row": [{ "text": "{cpu_temp}", "width": 38, "align": "right" }, { "space": -1 },
                { "text": "°", "font": "PROFONT12", "dy": 3 }, { "space": -1 }, "C"] }
    ] },
    { "leading": 11, "row": [
      { "width": 64, "row": [{ "text": "{ram_usage}", "width": 38, "align": "right" }, { "space": 2 },
                             { "text": "%", "font": "FONT_6X12", "dy": 1 }, { "text": "RAM", "font": "FONT_5X8", "dy": 1 }] },
      { "row": [{ "text": "{disk_usage}", "width": 38, "align": "right" },
                { "text": "%", "font": "FONT_6X12", "dy": 1 }, { "text": "DISK", "font": "FONT_5X8", "dy": 1 }] }
    ] }
  ]
}
